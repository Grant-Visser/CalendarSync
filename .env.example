# Primary calendar (the one you run your life from)
PRIMARY_CLIENT_ID=your-app-client-id-here
PRIMARY_TENANT_ID=your-tenant-id-here
PRIMARY_CALENDAR_ID=primary   # or a specific calendar ID from Graph

# Child calendar 1
CHILD_1_CLIENT_ID=your-app-client-id-here
CHILD_1_TENANT_ID=your-tenant-id-here
CHILD_1_CALENDAR_ID=primary

# Child calendar 2 (add as many CHILD_n_* blocks as you need)
CHILD_2_CLIENT_ID=your-app-client-id-here
CHILD_2_TENANT_ID=your-tenant-id-here
CHILD_2_CALENDAR_ID=primary

# Optional
SYNC_WINDOW_DAYS=30
STATE_FILE=~/.calendar_sync_state.json
TOKEN_CACHE_DIR=~/.calendar_sync_tokens
